variable "region" {
  type        = string
  description = "AWS region of the cluster."
}

variable "cluster_name" {
  type        = string
  description = "Name of the existing EKS cluster."
}

variable "node_role_arn" {
  type        = string
  description = "IAM role ARN for the nodes; copy it from the old node group."
}

variable "subnet_ids" {
  type        = list(string)
  description = "Subnets for the nodes; copy them from the old node group."
}

variable "ami_type" {
  type        = string
  description = "AL2023 or Bottlerocket AMI type (cgroup v2)."
  default     = "AL2023_x86_64_STANDARD"
}

variable "instance_types" {
  type        = list(string)
  description = "Instance types; copy them from the old node group."
  default     = ["m5.large"]
}

variable "desired_size" {
  type        = number
  description = "Desired node count."
  default     = 1
}
